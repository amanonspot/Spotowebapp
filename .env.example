# Copy to `.env.local` (dev) or set as build-args / server env (production).
# NEXT_PUBLIC_* values are embedded in the client bundle at build time.

# ── API (production) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://production.api.spoto.in
NEXT_PUBLIC_API_URL=https://production.api.spoto.in

# ── Mock modes — MUST be false in production ─────────────────────────────────
NEXT_PUBLIC_OWNER_MOCK_MODE=false
NEXT_PUBLIC_RENTALS_MOCK_MODE=false
NEXT_PUBLIC_OWNER_MOCK_OTP=

# ── Google Maps / Places ─────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# ── Payments ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYMENT_CLIENT_ID=spoto

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENV=production
NEXT_PUBLIC_FRONTEND_URL=https://spoto.in

# ── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_DEBUG_MODE=false
NEXT_PUBLIC_META_PIXEL_ID=
